{
  "openapi": "3.0.0",
  "info": {
    "title": "Payments Gateway API",
    "version": "2.0.0"
  },
  "paths": {
    "/v1/charges": {
      "post": {
        "summary": "Create charge",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "currency"],
                "properties": {
                  "amount": { "type": "integer" },
                  "currency": { "type": "string" },
                  "description": { "type": "string", "description": "Optional charge description" },
                  "metadata": { "type": "object", "description": "Custom metadata key-value pairs" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Charge created" }
        }
      }
    },
    "/v1/charges/{id}/refund": {
      "post": {
        "summary": "Refund charge",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Refund processed" }
        }
      }
    }
  }
}
